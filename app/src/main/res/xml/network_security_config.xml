<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local OpenAI-compatible gateways (Ollama/OneAPI) may use private HTTP. -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">api.tianditu.gov.cn</domain>
        <domain includeSubdomains="true">weatherapi.market.xiaomi.com</domain>
        <!-- 台风路径页面使用的高德地图 HTTP 瓦片 -->
        <domain includeSubdomains="true">is.autonavi.com</domain>
        <domain includeSubdomains="true">tf.istrongcloud.com</domain>
    </domain-config>
</network-security-config>
