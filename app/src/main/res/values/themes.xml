<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动屏主题：纯天空蓝（与主页晴天渐变顶色一致）+ 透明图标，
         退出时由 MainActivity 交叉淡化到主页，消除启动割裂感 -->
    <style name="Theme.SkyPulse" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/starting_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.SkyPulse.Main</item>
    </style>

    <!-- 启动屏退出后的正式主题 -->
    <style name="Theme.SkyPulse.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/starting_window_background</item>
    </style>
</resources>
