<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/widget_margin"
    android:clipChildren="true"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_rounded_bg"
        android:clipToOutline="true"
        android:clipChildren="true">

        <!-- Background fills the entire widget -->
        <ImageView
            android:id="@+id/widget_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Top section -->
        <LinearLayout
            android:id="@+id/widget_top_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="8dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="false">

            <!-- Left: Location icon + City + Temperature -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start|bottom">

                <!-- City with location icon -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="5dp"
                    android:translationY="3dp">

                    <ImageView
                        android:id="@+id/widget_location_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_widget_location"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:textColor="#EEFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:translationY="6dp"
                    android:textColor="@android:color/white"
                    android:textSize="42sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:includeFontPadding="false"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Middle: Wind + Humidity + AQI + UV -->
            <LinearLayout
                android:id="@+id/widget_params_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="5dp"
                android:translationY="3dp">

                <!-- Left column: Wind + Humidity -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="start">

                    <!-- Wind: "南风 2级" -->
                    <TextView
                        android:id="@+id/widget_wind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#DDFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />

                    <!-- Humidity: "湿度 89%" -->
                    <TextView
                        android:id="@+id/widget_humidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#DDFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Right column: AQI + UV -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="start"
                    android:layout_marginStart="8dp">

                    <!-- AQI: "空气 优" -->
                    <TextView
                        android:id="@+id/widget_aqi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#DDFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />

                    <!-- UV: "紫外线 弱" -->
                    <TextView
                        android:id="@+id/widget_uv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#DDFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: Weather icon + description aligned to bottom -->
            <LinearLayout
                android:id="@+id/widget_weather_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:id="@+id/widget_weather_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_weather_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:textColor="#EEFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom section: 5-day forecast -->
        <LinearLayout
            android:id="@+id/widget_daily_forecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- Day 1 -->
            <LinearLayout
                android:id="@+id/widget_day_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/widget_day_name_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#BBFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <ImageView
                    android:id="@+id/widget_day_icon_1"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginTop="-1dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_day_temp_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Day 2 -->
            <LinearLayout
                android:id="@+id/widget_day_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/widget_day_name_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#BBFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <ImageView
                    android:id="@+id/widget_day_icon_2"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginTop="-1dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_day_temp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Day 3 -->
            <LinearLayout
                android:id="@+id/widget_day_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/widget_day_name_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#BBFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <ImageView
                    android:id="@+id/widget_day_icon_3"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginTop="-1dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_day_temp_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Day 4 -->
            <LinearLayout
                android:id="@+id/widget_day_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/widget_day_name_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#BBFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <ImageView
                    android:id="@+id/widget_day_icon_4"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginTop="-1dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_day_temp_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Day 5 -->
            <LinearLayout
                android:id="@+id/widget_day_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/widget_day_name_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#BBFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <ImageView
                    android:id="@+id/widget_day_icon_5"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginTop="-1dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_day_temp_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>